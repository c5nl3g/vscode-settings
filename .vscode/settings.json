{
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "lumirelle.shell-format-rev"
  },
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "chat.agent.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "cSpell.allowCompoundWords": true,
  "cSpell.userWords": [
    "arktype",
    "blurhash",
    "cillian",
    "clsx",
    "demi",
    "dotenv",
    "effecttsgo",
    "esbuild",
    "evlog",
    "iconify",
    "leung",
    "lucide",
    "mdsvex",
    "nums",
    "Nuxt",
    "nuxtjs",
    "ofetch",
    "oslojs",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "paraglide",
    "persistedstate",
    "pinia",
    "reka",
    "scule",
    "shadcn",
    "Slideover",
    "Slidev",
    "taze",
    "tsgo",
    "tsgolint",
    "uidx",
    "unovis",
    "uuidv",
    "vaul",
    "vite",
    "vueuse",
    "workerd"
  ],
  "debug.onTaskErrors": "debugAnyway",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.fontFamily": "'Paper Mono', 'Symbols Nerd Font Mono'",
  "editor.fontLigatures": "'ss01', 'ss04', 'zero'",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.excludeBySource": [
    "cSpell",
    "Grammarly"
  ],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.associations": {
    ".zshrc": "shellscript",
    "*.css": "tailwindcss"
  },
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "gitlens.menus": {
    "editor": {
      "blame": false,
      "clipboard": true,
      "compare": true,
      "history": false,
      "remote": false
    },
    "editorGroup": {
      "blame": true,
      "compare": false
    },
    "editorTab": {
      "clipboard": true,
      "compare": true,
      "history": true,
      "remote": true
    },
    "explorer": {
      "clipboard": true,
      "compare": true,
      "history": true,
      "remote": true
    },
    "scm": {
      "authors": true
    },
    "scmGroup": {
      "compare": true,
      "openClose": true,
      "stash": true
    },
    "scmGroupInline": {
      "stash": true
    },
    "scmItem": {
      "clipboard": true,
      "compare": true,
      "history": true,
      "remote": false,
      "stash": true
    }
  },
  "i18n-ally.autoDetection": false,
  "i18n-ally.displayLanguage": "en",
  "i18n-ally.ignoredLocales": [],
  "oxc.typeAware": true,
  "python.analysis.typeCheckingMode": "standard",
  "remote.autoForwardPortsSource": "hybrid",
  "search.exclude": {
    "**/.git": true,
    "**/.github": false,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/*.snap": true,
    "**/*.svg": true,
    "**/assets": true,
    "**/CHANGELOG*": true,
    "**/dist/**": true,
    "**/LICENSE*": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/public": true,
    "**/temp": true
  },
  "security.workspace.trust.untrustedFiles": "open",
  "tailwindCSS.classAttributes": [
    "class",
    "ui"
  ],
  "tailwindCSS.classFunctions": [
    "cn",
    "defineAppConfig"
  ],
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "\"ss01\", \"ss04\", \"zero\"",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.splitCwd": "workspaceRoot",
  "todo-tree.ripgrep.ripgrep": "C:\\Users\\cillian\\AppData\\Local\\Microsoft\\WinGet\\Links\\rg.exe",
  "vsicons.dontShowNewVersionMessage": true,
  "window.dialogStyle": "custom",
  "window.title": "${rootName}",
  "window.zoomLevel": 1,
  "window.zoomPerWindow": false,
  "workbench.browser.openLocalhostLinks": false,
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "workbench.iconTheme": "vscode-icons",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
